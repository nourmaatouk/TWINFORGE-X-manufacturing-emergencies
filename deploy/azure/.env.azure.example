# ═══════════════════════════════════════════════════════════════
# TWINFORGE — Azure Deployment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.azure and fill in your values.
# The deploy scripts read Backend/.env automatically for
# JWT_SECRET, OTP_SECRET, RESEND_API_KEY, etc.
#
# Usage:
#   cp deploy/azure/.env.azure.example .env.azure
#   # Edit .env.azure
#   .\deploy\azure\deploy-azure.ps1
# ═══════════════════════════════════════════════════════════════

# Azure Resource Group
AZURE_RESOURCE_GROUP=twinforge-rg

# Azure region (run: az account list-locations -o table)
AZURE_LOCATION=eastus

# Azure Container Registry name — must be globally unique, lowercase, 5-50 chars
# Change this to something unique like: twinforge<yourname>acr
AZURE_ACR_NAME=twinforgeacr

# Container Apps Environment name
AZURE_CONTAINER_APP_ENV=twinforge-env

# ── Security Keys ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# If left empty, the deploy script auto-generates them.
MESSAGE_SIGNING_KEY=
REDIS_PASSWORD=

# ── Auth Backend ──────────────────────────────────────────────
# These are read automatically from Backend/.env by the deploy script.
# Only set them here if you want to OVERRIDE Backend/.env values.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# JWT_SECRET=your_jwt_secret
# OTP_SECRET=your_otp_secret

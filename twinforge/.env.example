# TWINFORGE Environment Variables
# Copy this file to .env and fill in the values

# Database
POSTGRES_PASSWORD=changeme_postgres_password
INFLUXDB_PASSWORD=changeme_influx_password

# Vault
VAULT_ROOT_TOKEN=changeme_vault_root_token

# Claude API
CLAUDE_API_KEY=sk-ant-your-api-key-here

# Security
MESSAGE_SIGNING_KEY=changeme_hmac_signing_key_min_32_chars

# Alerting
PAGERDUTY_WEBHOOK=https://events.pagerduty.com/integration/your-key/enqueue
SLACK_WEBHOOK=https://hooks.slack.com/services/your/webhook/url

# Grafana
GRAFANA_PASSWORD=changeme_grafana_password

# ─── Agent 3: Data/IoT Executor ──────────────────────────────
# Copy this file to .env and fill in values

# ── Service ─────────────────────────────────────────────────
SERVICE_NAME=agent-data-iot
SERVICE_PORT=8003
LOG_LEVEL=INFO

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_TELEMETRY_CHANNEL=telemetry:live
REDIS_ALERTS_CHANNEL=telemetry:alerts

# ── InfluxDB ────────────────────────────────────────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-secret-token
INFLUXDB_ORG=twinforge
INFLUXDB_BUCKET=twinforge_sensors

# ── MQTT ────────────────────────────────────────────────────
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=twinforge/telemetry/#
MQTT_TOPIC_PUBLISH=twinforge/telemetry/live
MQTT_CLIENT_ID=agent-data-iot

# ── Security ────────────────────────────────────────────────
MESSAGE_SIGNING_KEY=change-me-in-production

# ── Observability ───────────────────────────────────────────
OTEL_ENDPOINT=http://otel-collector:4317

# ── Anomaly Thresholds ─────────────────────────────────────
VIBRATION_THRESHOLD=8.0
TEMPERATURE_THRESHOLD=95.0
ENERGY_SPIKE_FACTOR=2.0
WATER_SPIKE_FACTOR=2.5
ROLLING_WINDOW_SIZE=30
DEVIATION_MULTIPLIER=2.5

# ── Simulation Defaults ────────────────────────────────────
DEFAULT_NUM_MACHINES=5
DEFAULT_SIMULATION_HOURS=4.0
DEFAULT_SAMPLING_INTERVAL=5
DEFAULT_ANOMALY_FREQUENCY=0.05
DEFAULT_PRODUCTION_INTENSITY=0.7
MAX_CONCURRENT_SIMULATIONS=5

# ── Vault ───────────────────────────────────────────────────
VAULT_URL=http://vault:8200
VAULT_TOKEN=

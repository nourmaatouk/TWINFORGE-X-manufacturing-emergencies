# ═══════════════════════════════════════════════════════════
# LOCAL DEV (default — works with http://localhost:18080)
# ═══════════════════════════════════════════════════════════
APP_ORIGIN=http://localhost:18080
APP_ORIGINS=http://localhost:18080
AUTH_LOGIN_URL=http://localhost:18080
VITE_DASHBOARD_URL=http://localhost:18080/dashboard/
DASHBOARD_URL=http://localhost:18080/dashboard/

# ═══════════════════════════════════════════════════════════
# CLOUDFLARE TUNNEL TOKEN
# Paste the token from:
#   Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token
# ═══════════════════════════════════════════════════════════
CLOUDFLARE_TUNNEL_TOKEN=replace_with_real_tunnel_token

# ═══════════════════════════════════════════════════════════
# PRODUCTION (uncomment and fill when deploying via Cloudflare)
# Replace twinforge.your-domain.com with your real hostname
# Then run: .\scripts\run-platform.ps1 -Mode docker-cloudflare
# ═══════════════════════════════════════════════════════════
# APP_ORIGIN=https://twinforge.your-domain.com
# APP_ORIGINS=https://twinforge.your-domain.com
# AUTH_LOGIN_URL=https://twinforge.your-domain.com
# VITE_DASHBOARD_URL=https://twinforge.your-domain.com/dashboard/
# DASHBOARD_URL=https://twinforge.your-domain.com/dashboard/

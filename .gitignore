# Ignore node_modules in both frontend and backend
Frontend/node_modules/
Backend/node_modules/

# Ignore environment files
*.env
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Datasets (large files)
datasets/*.csv
datasets/*.parquet
!datasets/.gitkeep

# Vault data
infrastructure/vault/data/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Claude Code temp files
tmpclaude-*-cwd
nul

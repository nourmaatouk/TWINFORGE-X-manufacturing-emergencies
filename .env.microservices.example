# Public URLs
APP_ORIGIN=http://localhost:18080
APP_ORIGINS=http://localhost:18080
AUTH_LOGIN_URL=http://localhost:18080
VITE_DASHBOARD_URL=http://localhost:18080/dashboard
DASHBOARD_URL=http://localhost:18080/dashboard

# Cloudflare tunnel (required for cloudflare profile)
CLOUDFLARE_TUNNEL_TOKEN=replace_with_real_tunnel_token

